/* ROOMS */

function renderRooms(){

  let container =
  document.getElementById(
    "roomsContainer"
  );



  container.innerHTML = "";



  let busyCount = bookings.length;



  // ЗАНЯТЫЕ

  bookings.forEach((room,index) => {

    container.innerHTML += `

      <div class="room-card busy">

        <h3>
          Номер ${room.number}
          — ${room.type}
        </h3>

        <p>
          <strong>Статус:</strong>
          Занят
        </p>

        <p>
          <strong>Клиент:</strong>
          ${room.client}
        </p>

        <p>
          <strong>Телефон:</strong>
          ${room.phone}
        </p>

        <p>
          <strong>Заезд:</strong>
          ${room.checkin}
        </p>

        <p>
          <strong>Выезд:</strong>
          ${room.checkout}
        </p>

        <button
          class="delete-btn"
          onclick="deleteBooking(${index})">

          Удалить бронь

        </button>

      </div>

    `;

  });



  // СВОБОДНЫЕ

  allRooms.forEach(room => {

    let busy =
    bookings.find(
      item => item.number == room.number
    );



    if(!busy){

      container.innerHTML += `

        <div class="room-card free">

          <h3>
            Номер ${room.number}
            — ${room.type}
          </h3>

          <p>
            <strong>Статус:</strong>
            Свободен
          </p>

        </div>

      `;

    }

  });



  document.getElementById(
    "busyRooms"
  ).innerText = busyCount;



  document.getElementById(
    "freeRooms"
  ).innerText =
  20 - busyCount;

}



/* ROOM SELECT */

function updateRoomSelect(){

  let type =
  document.getElementById(
    "roomType"
  ).value;



  let roomSelect =
  document.getElementById(
    "roomNumber"
  );



  roomSelect.innerHTML = "";



  let freeRooms =
  allRooms.filter(room => {

    let busy =
    bookings.find(
      item => item.number == room.number
    );



    return (
      room.type === type
      &&
      !busy
    );

  });



  freeRooms.forEach(room => {

    roomSelect.innerHTML += `

      <option>
        ${room.number}
      </option>

    `;

  });

}



/* ADD BOOKING */

function addBooking(){

  let client =
  document.getElementById(
    "clientName"
  ).value;



  let phone =
  document.getElementById(
    "clientPhone"
  ).value;



  let checkin =
  document.getElementById(
    "checkin"
  ).value;



  let checkout =
  document.getElementById(
    "checkout"
  ).value;



  let type =
  document.getElementById(
    "roomType"
  ).value;



  let number =
  document.getElementById(
    "roomNumber"
  ).value;



  if(client === ""){

    alert("Введите ФИО");

    return;

  }



  let booking = {

    number:number,

    type:type,

    client:client,

    phone:phone,

    checkin:checkin,

    checkout:checkout

  };



  bookings.push(booking);



  localStorage.setItem(
    "bookings",
    JSON.stringify(bookings)
  );



  renderRooms();

  updateRoomSelect();



  alert(
    "Бронь успешно добавлена"
  );

}



/* DELETE BOOKING */

function deleteBooking(index){

  let confirmDelete =
  confirm(
    "Удалить бронь?"
  );



  if(confirmDelete){

    bookings.splice(index,1);



    localStorage.setItem(
      "bookings",
      JSON.stringify(bookings)
    );



    renderRooms();

    updateRoomSelect();

  }

}
